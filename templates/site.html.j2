<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
<meta property="og:title" content="{{ meta.title }}">
<meta property="og:description" content="{{ meta.description }}">
<meta property="og:type" content="business.business">
<meta property="og:image" content="assets/{{ galerie[0].fichier_local }}">
<link rel="icon" href="assets/profil.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ typo.titre_font|replace(' ', '+') }}:wght@400;500;600;700&family={{ typo.texte_font|replace(' ', '+') }}:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --primaire: {{ palette.primaire }};
  --secondaire: {{ palette.secondaire }};
  --neutre-fonce: {{ palette.neutre_fonce }};
  --neutre-clair: {{ palette.neutre_clair|default('#fdfaf6') }};
  --blanc: #ffffff;
  --font-titre: "{{ typo.titre_font }}", serif;
  --font-texte: "{{ typo.texte_font }}", sans-serif;
  --max-content: 1200px;
  --rayon: 8px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-texte);
  color: var(--neutre-fonce);
  background: var(--neutre-clair);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
h1, h2, h3, h4 { font-family: var(--font-titre); font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; color: var(--neutre-fonce); }
h1 { font-size: clamp(2rem, 5vw, 3.8rem); }
h2 { font-size: clamp(1.6rem, 3.5vw, 2.6rem); margin-bottom: 0.5em; }
h3 { font-size: 1.25rem; margin-bottom: 0.4em; }
p { font-size: 1.05rem; }
.container { max-width: var(--max-content); margin: 0 auto; padding: 0 24px; }

/* Header */
header.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
  padding: 14px 20px; border-bottom: 1px solid rgba(0,0,0,0.05);
}
header.nav .inner {
  max-width: var(--max-content); margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  gap: 14px;
}
header.nav .logo {
  font-family: var(--font-titre); font-size: 1.25rem; font-weight: 600; color: var(--primaire);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  min-width: 0; flex: 1 1 auto;
}
header.nav nav { flex: 0 0 auto; }
header.nav nav a { margin-left: 28px; font-size: 0.95rem; opacity: 0.8; transition: opacity .2s; }
header.nav nav a:hover { opacity: 1; }
header.nav .btn-reserve { margin-left: 12px; flex: 0 0 auto; white-space: nowrap; padding: 10px 18px; font-size: 0.88rem; }
@media (max-width: 860px) {
  header.nav nav { display: none; }
}
.btn-reserve .cta-short { display: none; }
@media (max-width: 480px) {
  header.nav { padding: 12px 14px; }
  header.nav .logo { font-size: 1.05rem; max-width: 55vw; }
  header.nav .btn-reserve { padding: 8px 14px; font-size: 0.82rem; }
  .btn-reserve .cta-full { display: none; }
  .btn-reserve .cta-short { display: inline; }
}

/* Bouton */
.btn {
  display: inline-block; padding: 14px 28px;
  background: var(--primaire); color: var(--blanc);
  border: none; border-radius: var(--rayon);
  font-family: var(--font-texte); font-weight: 500; font-size: 0.95rem;
  letter-spacing: 0.02em; cursor: pointer; transition: transform .15s, box-shadow .15s, background .2s;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.15); }
.btn-outline { background: transparent; color: var(--primaire); border: 1.5px solid var(--primaire); }
.btn-outline:hover { background: var(--primaire); color: var(--blanc); }

/* Hero */
section.hero {
  margin-top: 60px; padding: 80px 24px 100px;
  display: grid; grid-template-columns: 1.1fr 1fr; gap: 60px; align-items: center;
  max-width: var(--max-content); margin-left: auto; margin-right: auto;
}
section.hero .h1-block { max-width: 560px; }
section.hero h1 { margin-bottom: 0.4em; }
section.hero .tagline { font-size: clamp(1.05rem, 1.7vw, 1.25rem); opacity: 0.78; margin-bottom: 2em; }
section.hero .ctas { display: flex; gap: 16px; flex-wrap: wrap; }
section.hero .img-wrap {
  position: relative; aspect-ratio: 4/5; border-radius: 16px; overflow: hidden;
  box-shadow: 0 30px 60px -20px rgba(0,0,0,0.25);
}
section.hero .img-wrap img { width: 100%; height: 100%; object-fit: cover; }
section.hero .img-wrap::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--primaire) 25%, transparent));
}
@media (max-width: 860px) {
  section.hero { grid-template-columns: 1fr; gap: 40px; padding: 60px 24px; }
  section.hero .img-wrap { aspect-ratio: 1/1; }
}

/* About */
section.about {
  padding: 100px 24px;
  display: grid; grid-template-columns: 1fr 1.2fr; gap: 60px;
  max-width: var(--max-content); margin: 0 auto; align-items: center;
}
section.about .img-side { aspect-ratio: 1/1; border-radius: 16px; overflow: hidden; }
section.about .img-side img { width: 100%; height: 100%; object-fit: cover; }
section.about h2 { color: var(--primaire); margin-bottom: 0.7em; }
section.about .lead { font-size: 1.1rem; opacity: 0.85; }
section.about p + p { margin-top: 1em; }
@media (max-width: 860px) { section.about { grid-template-columns: 1fr; padding: 60px 24px; } }

/* Services : editorial alterne */
section.services {
  padding: 100px 24px; background: var(--blanc);
}
section.services .container { max-width: var(--max-content); margin: 0 auto; }
section.services .header { text-align: center; max-width: 640px; margin: 0 auto 80px; }
section.services h2 { margin-bottom: 0.4em; }
section.services .intro { opacity: 0.7; }
section.services .item {
  display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
  align-items: center; margin-bottom: 100px;
}
section.services .item:last-child { margin-bottom: 0; }
section.services .item.reverse { grid-template-columns: 1fr 1fr; }
section.services .item.reverse .photo { order: 2; }
section.services .item.reverse .content { order: 1; }
section.services .item .photo {
  aspect-ratio: 4/5; border-radius: 4px; overflow: hidden;
  box-shadow: 0 20px 50px -20px rgba(0,0,0,0.2);
  position: relative;
}
section.services .item .photo img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .8s cubic-bezier(.2,.7,.2,1);
}
section.services .item:hover .photo img { transform: scale(1.04); }
section.services .item .photo .num-overlay {
  position: absolute; top: 24px; left: 24px;
  font-family: var(--font-titre); font-size: 1rem; font-weight: 500;
  color: var(--blanc); background: color-mix(in srgb, var(--primaire) 80%, black);
  padding: 8px 14px; border-radius: 100px; letter-spacing: 0.1em;
}
section.services .item .content { max-width: 480px; }
section.services .item .eyebrow {
  font-family: var(--font-texte); font-size: 0.78rem; font-weight: 500;
  color: var(--primaire); letter-spacing: 0.15em; text-transform: uppercase;
  margin-bottom: 14px; display: block;
}
section.services .item h3 {
  font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 18px; line-height: 1.15;
}
section.services .item .desc { font-size: 1.05rem; opacity: 0.78; margin-bottom: 24px; }
section.services .item .meta {
  display: flex; gap: 16px; padding-top: 24px;
  border-top: 1px solid rgba(0,0,0,0.08);
}
section.services .item .meta .chip {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 0.88rem; color: var(--primaire); font-weight: 500;
}
section.services .item .meta .chip .ico {
  display: inline-block; width: 6px; height: 6px; border-radius: 50%;
  background: var(--primaire); opacity: 0.7;
}
@media (max-width: 860px) {
  section.services .item { grid-template-columns: 1fr; gap: 32px; margin-bottom: 60px; }
  section.services .item.reverse .photo { order: 0; }
  section.services .item.reverse .content { order: 1; }
  section.services .item .photo { aspect-ratio: 4/3; }
}

/* Raisons */
section.raisons {
  padding: 100px 24px;
  background: linear-gradient(180deg, var(--neutre-clair) 0%, color-mix(in srgb, var(--secondaire) 15%, var(--neutre-clair)) 100%);
}
section.raisons .container { text-align: center; }
section.raisons h2 { margin-bottom: 60px; }
section.raisons .grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px;
  text-align: left;
}
section.raisons .item .num-grand {
  font-family: var(--font-titre); font-size: 3rem; font-weight: 600;
  color: var(--primaire); line-height: 1; margin-bottom: 14px;
}
section.raisons .item h3 { margin-bottom: 0.4em; }
section.raisons .item p { opacity: 0.8; }

/* Galerie */
section.galerie {
  padding: 100px 24px; background: var(--blanc);
}
section.galerie .container { text-align: center; }
section.galerie h2 { margin-bottom: 0.4em; }
section.galerie .intro { opacity: 0.7; margin-bottom: 48px; }
section.galerie .grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
}
section.galerie .photo {
  aspect-ratio: 1/1; border-radius: var(--rayon); overflow: hidden;
  position: relative; cursor: pointer;
}
section.galerie .photo img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .4s ease;
}
section.galerie .photo:hover img { transform: scale(1.06); }
section.galerie .photo::after {
  content: ""; position: absolute; inset: 0;
  background: color-mix(in srgb, var(--primaire) 0%, transparent);
  transition: background .3s;
}
section.galerie .photo:hover::after { background: color-mix(in srgb, var(--primaire) 18%, transparent); }
@media (max-width: 640px) { section.galerie .grid { grid-template-columns: repeat(2, 1fr); } }

/* Avis */
section.avis {
  padding: 100px 24px;
  background: linear-gradient(180deg, var(--blanc) 0%, var(--neutre-clair) 100%);
}
section.avis .container { max-width: var(--max-content); margin: 0 auto; text-align: center; }
section.avis .header { margin-bottom: 60px; }
section.avis h2 { margin-bottom: 0.5em; }
section.avis .note-bandeau {
  display: inline-flex; align-items: center; gap: 16px;
  padding: 14px 28px; background: var(--blanc);
  border: 1px solid rgba(0,0,0,0.06); border-radius: 100px;
  box-shadow: 0 6px 20px -10px rgba(0,0,0,0.08);
  margin-bottom: 12px;
}
section.avis .note-bandeau .stars { color: #FFB400; font-size: 1.05rem; letter-spacing: 2px; }
section.avis .note-bandeau .note-num {
  font-family: var(--font-titre); font-size: 1.4rem; font-weight: 600;
  color: var(--neutre-fonce);
}
section.avis .note-bandeau .note-meta { font-size: 0.88rem; opacity: 0.7; }
section.avis .grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px; text-align: left; margin-top: 40px;
}
section.avis .card {
  padding: 30px 28px; background: var(--blanc);
  border-radius: 12px; border: 1px solid rgba(0,0,0,0.04);
  position: relative;
}
section.avis .card .stars-card {
  color: #FFB400; font-size: 0.95rem; letter-spacing: 2px; margin-bottom: 14px;
}
section.avis .card .texte {
  font-size: 0.98rem; line-height: 1.65; margin-bottom: 18px;
  color: var(--neutre-fonce); opacity: 0.88;
}
section.avis .card .texte::before { content: "« "; opacity: 0.4; }
section.avis .card .texte::after { content: " »"; opacity: 0.4; }
section.avis .card .auteur {
  font-size: 0.88rem; font-weight: 500; color: var(--primaire);
}
section.avis .card .date { font-size: 0.78rem; opacity: 0.55; margin-left: 8px; }
section.avis .voir-tout {
  margin-top: 40px; display: inline-block;
  font-size: 0.9rem; color: var(--primaire);
  border-bottom: 1px solid currentColor;
  padding-bottom: 2px; opacity: 0.85;
}

/* CTA bandeau */
section.cta-banner {
  padding: 80px 24px;
  background: linear-gradient(135deg, var(--primaire) 0%, color-mix(in srgb, var(--primaire) 75%, black) 100%);
  color: var(--blanc); text-align: center;
}
section.cta-banner h2 { color: var(--blanc); margin-bottom: 0.5em; }
section.cta-banner p { opacity: 0.92; max-width: 560px; margin: 0 auto 40px; }
section.cta-banner .btn {
  background: var(--blanc); color: var(--primaire);
}
section.cta-banner .btn:hover { background: var(--neutre-clair); }

/* Footer */
footer.footer {
  padding: 60px 24px 40px; background: var(--neutre-fonce); color: var(--neutre-clair);
}
footer.footer .container {
  display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 40px;
}
footer.footer h4 { color: var(--neutre-clair); font-family: var(--font-titre); margin-bottom: 12px; font-size: 1.1rem; }
footer.footer .brand-tagline { opacity: 0.7; max-width: 320px; margin-top: 8px; line-height: 1.6; }
footer.footer .brand-name { font-family: var(--font-titre); font-size: 1.4rem; color: var(--blanc); }
footer.footer a { opacity: 0.75; transition: opacity .2s; display: block; padding: 4px 0; }
footer.footer a:hover { opacity: 1; }
footer.footer .copy {
  grid-column: 1 / -1; margin-top: 40px; padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,0.1);
  opacity: 0.5; font-size: 0.85rem; text-align: center;
}
@media (max-width: 720px) { footer.footer .container { grid-template-columns: 1fr; } }

/* Animations au scroll */
.reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s ease, transform .8s ease; }
.reveal.in { opacity: 1; transform: none; }

/* Lightbox */
.lightbox {
  position: fixed; inset: 0; background: rgba(0,0,0,0.92);
  display: none; align-items: center; justify-content: center;
  z-index: 200; padding: 24px; cursor: pointer;
}
.lightbox.open { display: flex; }
.lightbox img { max-width: 92vw; max-height: 92vh; border-radius: 8px; }
.lightbox-close {
  position: absolute; top: 24px; right: 24px;
  background: rgba(255,255,255,0.15); color: white; border: none;
  width: 44px; height: 44px; border-radius: 50%; font-size: 1.5rem; cursor: pointer;
}
</style>
</head>
<body>

<header class="nav">
  <div class="inner">
    <a href="#" class="logo">{{ brand.fullName }}</a>
    <nav>
      <a href="#about">À propos</a>
      <a href="#services">Prestations</a>
      <a href="#galerie">Galerie</a>
      <a href="#contact">Contact</a>
    </nav>
    {% if booking_url %}<a href="{{ booking_url }}" target="_blank" rel="noopener" class="btn btn-reserve"><span class="cta-full">{{ copy.cta_principal }}</span><span class="cta-short">Réserver</span></a>{% endif %}
  </div>
</header>

<section class="hero">
  <div class="h1-block reveal">
    <h1>{{ copy.h1 }}</h1>
    <p class="tagline">{{ copy.tagline }}</p>
    <div class="ctas">
      {% if booking_url %}<a href="{{ booking_url }}" target="_blank" rel="noopener" class="btn">{{ copy.cta_principal }}</a>{% endif %}
      <a href="#services" class="btn btn-outline">{{ copy.cta_secondaire }}</a>
    </div>
  </div>
  <div class="img-wrap reveal">
    <img src="assets/{{ galerie[0].fichier_local }}" alt="{{ brand.fullName }}" loading="eager">
  </div>
</section>

<section id="about" class="about">
  <div class="img-side reveal">
    {% if galerie|length > 1 %}<img src="assets/{{ galerie[1].fichier_local }}" alt="{{ copy.about_titre }}" loading="lazy">{% endif %}
  </div>
  <div class="reveal">
    <h2>{{ copy.about_titre }}</h2>
    <p class="lead">{{ copy.about_texte }}</p>
  </div>
</section>

<section id="services" class="services">
  <div class="container">
    <div class="header reveal">
      <h2>{{ copy.services_titre }}</h2>
      <p class="intro">{{ brand.argument_unique }}</p>
    </div>
    {% for s in copy.services %}
    {% set photo_idx = s.photo_index if s.photo_index is defined and s.photo_index < galerie|length else (loop.index0 % galerie|length) %}
    <div class="item {% if loop.index is even %}reverse{% endif %} reveal">
      <div class="photo">
        <img src="assets/{{ galerie[photo_idx].fichier_local }}" alt="{{ s.nom }}" loading="lazy">
        <span class="num-overlay">0{{ loop.index }}</span>
      </div>
      <div class="content">
        <span class="eyebrow">Prestation {{ loop.index }}</span>
        <h3>{{ s.nom }}</h3>
        <p class="desc">{{ s.description }}</p>
        <div class="meta">
          {% if s.prix %}<span class="chip"><span class="ico"></span>{{ s.prix }}</span>{% endif %}
          {% if s.duree %}<span class="chip"><span class="ico"></span>{{ s.duree }}</span>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="raisons">
  <div class="container">
    <h2 class="reveal">{{ copy.raisons_titre }}</h2>
    <div class="grid">
      {% for r in copy.raisons %}
      <div class="item reveal">
        <div class="num-grand">0{{ loop.index }}</div>
        <h3>{{ r.titre }}</h3>
        <p>{{ r.texte }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="galerie" class="galerie">
  <div class="container">
    <h2 class="reveal">{{ copy.galerie_titre }}</h2>
    <p class="intro reveal">Quelques realisations recentes</p>
    <div class="grid">
      {% for p in galerie %}
      <div class="photo reveal" onclick="ouvreLightbox('assets/{{ p.fichier_local }}')">
        <img src="assets/{{ p.fichier_local }}" alt="{{ p.description }}" loading="lazy">
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if avis and (avis.note_moyenne or avis.avis) %}
<section id="avis" class="avis">
  <div class="container">
    <div class="header reveal">
      <h2>Ils en parlent</h2>
      {% if avis.note_moyenne %}
      <div class="note-bandeau">
        <span class="stars">{% for i in range(5) %}{% if i < (avis.note_moyenne | round(0, 'floor') | int) %}★{% else %}☆{% endif %}{% endfor %}</span>
        <span class="note-num">{{ avis.note_moyenne }}/5</span>
        {% if avis.nb_avis_total %}<span class="note-meta">sur {{ avis.nb_avis_total }} avis Google</span>{% endif %}
      </div>
      {% endif %}
    </div>
    {% if avis.avis %}
    <div class="grid">
      {% for a in avis.avis[:6] %}
      <div class="card reveal">
        <div class="stars-card">{% for i in range(5) %}{% if i < a.note %}★{% else %}☆{% endif %}{% endfor %}</div>
        <p class="texte">{{ a.texte[:280] }}{% if a.texte|length > 280 %}…{% endif %}</p>
        <div>
          <span class="auteur">{{ a.auteur }}</span>
          {% if a.date_relative %}<span class="date">{{ a.date_relative }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if avis.url_maps %}
    <a href="{{ avis.url_maps }}" target="_blank" rel="noopener" class="voir-tout">Voir tous les avis sur Google →</a>
    {% endif %}
  </div>
</section>
{% endif %}

<section id="contact" class="cta-banner">
  <h2 class="reveal">Prêt à prendre soin de vous ?</h2>
  <p class="reveal">{{ brand.argument_unique }}</p>
  {% if booking_url %}<a href="{{ booking_url }}" target="_blank" rel="noopener" class="btn reveal">{{ copy.cta_principal }}</a>{% endif %}
</section>

<footer class="footer">
  <div class="container">
    <div>
      <div class="brand-name">{{ brand.fullName }}</div>
      <p class="brand-tagline">{{ copy.footer_tagline }}</p>
    </div>
    <div>
      <h4>Navigation</h4>
      <a href="#about">À propos</a>
      <a href="#services">Prestations</a>
      <a href="#galerie">Galerie</a>
    </div>
    <div>
      <h4>Suivez-nous</h4>
      <a href="{{ brand.url_instagram }}" target="_blank" rel="noopener">Instagram (@{{ brand.handle }})</a>
      {% if booking_url %}<a href="{{ booking_url }}" target="_blank" rel="noopener">Reserver en ligne</a>{% endif %}
    </div>
    <div class="copy">© {{ annee }} {{ brand.fullName }} — Site genere automatiquement</div>
  </div>
</footer>

<div class="lightbox" id="lightbox" onclick="this.classList.remove('open')">
  <button class="lightbox-close" onclick="event.stopPropagation(); document.getElementById('lightbox').classList.remove('open')">&times;</button>
  <img id="lightboxImg" src="" alt="">
</div>

<script>
function ouvreLightbox(src) {
  document.getElementById('lightboxImg').src = src;
  document.getElementById('lightbox').classList.add('open');
}
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
</body>
</html>
